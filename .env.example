# Artflux Environment Configuration
# NOTE: The Android client contains ZERO Gemini API keys.
# GEMINI_API_KEY is stored strictly server-side in the backend environment / Cloud Run / Secret Manager.
# Do NOT place real Gemini API keys in this file.

# Optional backend proxy endpoint for Gemini AI source analysis.
# If empty or unreachable, Artflux automatically falls back to its built-in smart heuristic analyzer.
ARTFLUX_AI_BACKEND_URL=https://artflux-backend-proxy.run.app
